{
  "name": "@open-meeting-memo/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19 <23", "npm": ">=11 <12" },
  "packageManager": "npm@11.21.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:check": "node ../../scripts/generate-desktop-contracts.mjs --check && node tests/desktop_contracts.test.mjs",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "@tauri-apps/api": "2.12.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
