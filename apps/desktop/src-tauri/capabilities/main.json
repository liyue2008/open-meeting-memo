{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only reviewed, versioned OMM commands for the local main window; no filesystem, shell or remote grants.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-desktop-info",
    "allow-meeting-list",
    "allow-meeting-get",
    "allow-meeting-update",
    "allow-meeting-trash",
    "allow-meeting-restore",
    "allow-import-select",
    "allow-import-commit",
    "allow-import-cancel",
    "allow-record-status",
    "allow-record-start",
    "allow-record-stop",
    "allow-record-auto-set",
    "allow-artifact-versions",
    "allow-artifact-read",
    "allow-artifact-export",
    "allow-meeting-batch-export",
    "allow-artifact-copy",
    "allow-processing-enqueue",
    "allow-processing-retry",
    "allow-processing-cancel",
    "allow-processing-requeue",
    "allow-task-list",
    "allow-task-get",
    "allow-config-get",
    "allow-config-validate",
    "allow-config-save",
    "allow-diagnostics-get",
    "allow-diagnostics-export",
    "allow-notification-history",
    "allow-media-manifest",
    "allow-media-open",
    "allow-media-close",
    "allow-profile-initialize",
    "allow-service-plan",
    "allow-service-apply"
  ]
}
